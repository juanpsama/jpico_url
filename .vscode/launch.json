{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run FastAPI (dev)",
            "type": "debugpy",
            "request": "launch",

            "module": "fastapi",
            "args": [
                "dev",
                "app/main.py",
                "--host=0.0.0.0",
                "--port=8000"
            ],

            "console": "integratedTerminal",
            "python": "${workspaceFolder}/venv/bin/python3",
            "cwd": "${workspaceFolder}",
            "env": {}
        }
    ]
}
